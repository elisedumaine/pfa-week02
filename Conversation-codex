def time_look(hour):
    if 5 <= hour < 8:
        return ("SUNRISE", (.85, .48, .32), (1.0, .55, .32),
                0.75, 0.18, (.08, .18, .38))
    if 8 <= hour < 17:
        return ("DAYTIME", (.30, .52, .72), (1.0, .82, .65),
                1.25, 0.28, (.02, .11, .36))
    if 17 <= hour < 21:
        return ("SUNSET", (.63, .29, .40), (1.0, .38, .22),
                0.85, 0.20, (.10, .07, .25))
    return ("MOONLIT NIGHT", (.03, .05, .16), (.32, .40, .80),
            0.32, 0.10, (.015, .035, .14))

def update_time_of_day(*_unused):
    hour = cmds.intSliderGrp("timeSlider", query=True, value=True)
    label, sky, light_colour, intensity, fill, water = time_look(hour)

    if cmds.control("timeReadout", exists=True):
        cmds.text(
            "timeReadout",
            edit=True,
            label="%s  ·  %02d:00" % (label, hour)
        )

    cmds.displayRGBColor("background", sky[0], sky[1], sky[2])

    if not cmds.objExists(ROOT):
        return

    if cmds.objExists("island_key_light"):
        cmds.setAttr("island_key_light.intensity", intensity)
        cmds.setAttr(
            "island_key_light.color",
            light_colour[0], light_colour[1], light_colour[2],
            type="double3"
        )

        light_transform = cmds.listRelatives(
            "island_key_light", parent=True, fullPath=True
        ) or []

        if light_transform:
            cmds.xform(
                light_transform[0],
                rotation=(-42, -105 + hour * 9, 0)
            )

    if cmds.objExists("island_fill_light"):
        cmds.setAttr("island_fill_light.intensity", fill)

    material("island_ocean", water)
```

